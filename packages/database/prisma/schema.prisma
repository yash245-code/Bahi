// ═══════════════════════════════════════════════════════════
// Bahi CRM & ERP Business Suite — Prisma Schema (PostgreSQL)
// Multi-tenant architecture with Row-Level Security (RLS) support
// ═══════════════════════════════════════════════════════════

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearchPostgres"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Platform & Core Multi-Tenancy ─────────────────────────

model Tenant {
  id             String       @id @default(uuid()) @db.Uuid
  name           String       @db.VarChar(255)
  slug           String       @unique @db.VarChar(100)
  plan           PlanTier     @default(STARTER)
  status         TenantStatus @default(TRIAL)
  enabledModules String[]     @default(["core", "crm", "sales"])
  currency       String       @default("USD") @db.VarChar(10)
  timezone       String       @default("UTC") @db.VarChar(50)
  dateFormat     String       @default("YYYY-MM-DD") @db.VarChar(30)
  numberFormat   String       @default("en-US") @db.VarChar(30)
  fiscalYearStart Int         @default(1)
  workingHours   Json         @default("{\"start\":\"09:00\",\"end\":\"18:00\",\"workDays\":[1,2,3,4,5]}")
  holidays       Json         @default("[]")
  accentColor    String       @default("#A8462F") @db.VarChar(30)
  logoUrl        String?      @db.Text
  customDomain   String?      @unique @db.VarChar(255)
  settings       Json         @default("{}")
  createdAt      DateTime     @default(now()) @db.Timestamptz
  updatedAt      DateTime     @updatedAt @db.Timestamptz
  deletedAt      DateTime?    @db.Timestamptz

  users                  User[]
  roles                  Role[]
  teams                  Team[]
  territories            Territory[]
  contacts               Contact[]
  companies              Company[]
  leads                  Lead[]
  pipelines              Pipeline[]
  pipelineStages         PipelineStage[]
  opportunities          Opportunity[]
  dealLineItems          DealLineItem[]
  stageHistories         StageHistory[]
  activities             Activity[]
  communications         Communication[]
  products               Product[]
  priceLists             PriceList[]
  quotes                 Quote[]
  attachments            Attachment[]
  customFieldDefinitions CustomFieldDefinition[]
  savedViews             SavedView[]
  automationRules        AutomationRule[]
  sequences              Sequence[]
  webForms               WebForm[]
  importJobs             ImportJob[]
  auditLogs              AuditLog[]
  goals                  Goal[]
  lostReasons            LostReason[]
  leadSources            LeadSource[]
  campaigns              Campaign[]
  notifications          Notification[]
  approvalRequests       ApprovalRequest[]

  // Modular ERP Modules (Sales, Inventory, Accounting, HR, Projects)
  quotations             Quotation[]
  salesOrders            SalesOrder[]
  warehouses             Warehouse[]
  stockMoves             StockMove[]
  invoices               Invoice[]
  payments               Payment[]
  employees              Employee[]
  leaveRequests          LeaveRequest[]
  projects               Project[]

  @@map("tenants")
}

enum PlanTier {
  STARTER
  GROWTH
  BUSINESS
  ENTERPRISE
}

enum TenantStatus {
  TRIAL
  ACTIVE
  SUSPENDED
  CANCELLED
}

model User {
  id                String     @id @default(uuid()) @db.Uuid
  tenantId          String     @db.Uuid
  email             String     @db.VarChar(255)
  passwordHash      String     @db.VarChar(255)
  firstName         String     @db.VarChar(100)
  lastName          String     @db.VarChar(100)
  phone             String?    @db.VarChar(50)
  avatarUrl         String?    @db.Text
  status            UserStatus @default(ACTIVE)
  roleId            String?    @db.Uuid
  teamId            String?    @db.Uuid
  managerId         String?    @db.Uuid
  twoFactorSecret   String?    @db.VarChar(255)
  twoFactorEnabled  Boolean    @default(false)
  lastLoginAt       DateTime?  @db.Timestamptz
  createdAt         DateTime   @default(now()) @db.Timestamptz
  updatedAt         DateTime   @updatedAt @db.Timestamptz
  deletedAt         DateTime?  @db.Timestamptz
  createdBy         String?    @db.Uuid
  updatedBy         String?    @db.Uuid

  tenant            Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role              Role?      @relation(fields: [roleId], references: [id])
  team              Team?      @relation(fields: [teamId], references: [id])
  manager           User?      @relation("UserManager", fields: [managerId], references: [id])
  subordinates      User[]     @relation("UserManager")

  activities        Activity[]
  auditLogs         AuditLog[]
  assignedLeads     Lead[]
  assignedDeals     Opportunity[]
  assignedCompanies Company[]
  assignedContacts  Contact[]
  goals             Goal[]
  notifications     Notification[]
  requestedApprovals ApprovalRequest[] @relation("ApprovalRequester")
  assignedApprovals  ApprovalRequest[] @relation("ApprovalApprover")

  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([tenantId, email])
  @@map("users")
}

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
  DISABLED
}

model Role {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @db.Uuid
  name            String   @db.VarChar(100)
  description     String?  @db.Text
  permissions     String[] @default([])
  fieldVisibility Json     @default("{}")
  isDefault       Boolean  @default(false)
  createdAt       DateTime @default(now()) @db.Timestamptz
  updatedAt       DateTime @updatedAt @db.Timestamptz
  deletedAt       DateTime? @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users  User[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("roles")
}

model Team {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @db.Uuid
  name        String    @db.VarChar(100)
  description String?   @db.Text
  leadId      String?   @db.Uuid
  createdAt   DateTime  @default(now()) @db.Timestamptz
  updatedAt   DateTime  @updatedAt @db.Timestamptz
  deletedAt   DateTime? @db.Timestamptz

  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  members       User[]
  opportunities Opportunity[]
  goals         Goal[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("teams")
}

model Territory {
  id            String            @id @default(uuid()) @db.Uuid
  tenantId      String            @db.Uuid
  name          String            @db.VarChar(100)
  criteriaType  TerritoryCriteria @default(COUNTRY)
  criteriaValue String[]          @default([])
  managerId     String?           @db.Uuid
  createdAt     DateTime          @default(now()) @db.Timestamptz
  updatedAt     DateTime          @updatedAt @db.Timestamptz
  deletedAt     DateTime?         @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("territories")
}

enum TerritoryCriteria {
  COUNTRY
  STATE
  CITY
  PINCODE
  INDUSTRY
}

// ─── CRM Domain: Companies & Accounts ──────────────────────

model Company {
  id              String       @id @default(uuid()) @db.Uuid
  tenantId        String       @db.Uuid
  name            String       @db.VarChar(255)
  legalName       String?      @db.VarChar(255)
  domain          String?      @db.VarChar(255)
  industry        String?      @db.VarChar(100)
  size            String?      @db.VarChar(50) // e.g. "1-10", "11-50", "51-200"
  annualRevenue   Decimal?     @db.Decimal(16, 2)
  currency        String       @default("USD") @db.VarChar(10)
  billingAddress  Json         @default("{}")
  shippingAddress Json         @default("{}")
  taxId           String?      @db.VarChar(50) // GSTIN / VAT ID
  parentCompanyId String?      @db.Uuid
  ownerId         String?      @db.Uuid
  accountTier     AccountTier  @default(SMB)
  healthScore     Int          @default(100)
  tags            String[]     @default([])
  socialLinks     Json         @default("{}")
  customFields    Json         @default("{}")
  createdAt       DateTime     @default(now()) @db.Timestamptz
  updatedAt       DateTime     @updatedAt @db.Timestamptz
  deletedAt       DateTime?    @db.Timestamptz
  createdBy       String?      @db.Uuid
  updatedBy       String?      @db.Uuid

  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  owner         User?         @relation(fields: [ownerId], references: [id])
  parentCompany Company?      @relation("CompanyHierarchy", fields: [parentCompanyId], references: [id])
  subsidiaries  Company[]     @relation("CompanyHierarchy")
  contacts      Contact[]
  opportunities Opportunity[]
  quotes        Quote[]

  @@index([tenantId])
  @@index([tenantId, name])
  @@index([tenantId, domain])
  @@index([tenantId, ownerId])
  @@map("companies")
}

enum AccountTier {
  STRATEGIC
  ENTERPRISE
  MID_MARKET
  SMB
}

// ─── CRM Domain: Contacts ──────────────────────────────────

model Contact {
  id                String         @id @default(uuid()) @db.Uuid
  tenantId          String         @db.Uuid
  firstName         String         @db.VarChar(100)
  lastName          String         @db.VarChar(100)
  salutation        String?        @db.VarChar(20)
  emails            Json           @default("[]") // [{ email: string, isPrimary: boolean, label: string }]
  phones            Json           @default("[]") // [{ phone: string, type: string, isWhatsApp: boolean, isPrimary: boolean }]
  jobTitle          String?        @db.VarChar(150)
  department        String?        @db.VarChar(100)
  companyId         String?        @db.Uuid
  address           Json           @default("{}")
  birthday          DateTime?      @db.Date
  socialLinks       Json           @default("{}")
  language          String         @default("en") @db.VarChar(10)
  timezone          String         @default("UTC") @db.VarChar(50)
  source            String?        @db.VarChar(100)
  ownerId           String?        @db.Uuid
  lifecycleStage    LifecycleStage @default(LEAD)
  tags              String[]       @default([])
  consentFlags      Json           @default("{\"marketing\":true,\"doNotContact\":false,\"gdprConsentDate\":null}")
  avatarUrl         String?        @db.Text
  lastContactedDate DateTime?      @db.Timestamptz
  customFields      Json           @default("{}")
  createdAt         DateTime       @default(now()) @db.Timestamptz
  updatedAt         DateTime       @updatedAt @db.Timestamptz
  deletedAt         DateTime?      @db.Timestamptz
  createdBy         String?        @db.Uuid
  updatedBy         String?        @db.Uuid

  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company       Company?      @relation(fields: [companyId], references: [id])
  owner         User?         @relation(fields: [ownerId], references: [id])
  leads         Lead[]
  opportunities Opportunity[]
  quotes        Quote[]

  // ERP references
  quotations    Quotation[]
  salesOrders   SalesOrder[]
  invoices      Invoice[]
  employees     Employee[]

  @@index([tenantId])
  @@index([tenantId, lastName, firstName])
  @@index([tenantId, companyId])
  @@index([tenantId, ownerId])
  @@index([tenantId, lifecycleStage])
  @@map("contacts")
}

enum LifecycleStage {
  SUBSCRIBER
  LEAD
  MQL
  SQL
  OPPORTUNITY
  CUSTOMER
  EVANGELIST
  OTHER
}

// ─── CRM Domain: Leads & Intake ────────────────────────────

model Lead {
  id                 String     @id @default(uuid()) @db.Uuid
  tenantId           String     @db.Uuid
  contactId          String?    @db.Uuid
  companyName        String?    @db.VarChar(255)
  title              String     @db.VarChar(255)
  source             String?    @db.VarChar(100)
  campaignId         String?    @db.Uuid
  status             LeadStatus @default(NEW)
  score              Int        @default(0)
  rating             LeadRating @default(WARM)
  ownerId            String?    @db.Uuid
  interestNotes      String?    @db.Text
  convertedContactId String?    @db.Uuid
  convertedCompanyId String?    @db.Uuid
  convertedDealId    String?    @db.Uuid
  convertedAt        DateTime?  @db.Timestamptz
  disqualifiedReason String?    @db.Text
  disqualifiedAt     DateTime?  @db.Timestamptz
  recycledAt         DateTime?  @db.Timestamptz
  lastActivityAt     DateTime?  @db.Timestamptz
  customFields       Json       @default("{}")
  createdAt          DateTime   @default(now()) @db.Timestamptz
  updatedAt          DateTime   @updatedAt @db.Timestamptz
  deletedAt          DateTime?  @db.Timestamptz
  createdBy          String?    @db.Uuid
  updatedBy          String?    @db.Uuid

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact  Contact?  @relation(fields: [contactId], references: [id])
  owner    User?     @relation(fields: [ownerId], references: [id])
  campaign Campaign? @relation(fields: [campaignId], references: [id])

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, rating])
  @@index([tenantId, score])
  @@index([tenantId, ownerId])
  @@map("leads")
}

enum LeadStatus {
  NEW
  CONTACTED
  WORKING
  QUALIFIED
  UNQUALIFIED
  CONVERTED
}

enum LeadRating {
  HOT
  WARM
  COLD
}

// ─── CRM Domain: Pipelines, Stages & Opportunities ──────────

model Pipeline {
  id        String          @id @default(uuid()) @db.Uuid
  tenantId  String          @db.Uuid
  name      String          @db.VarChar(100)
  isDefault Boolean         @default(false)
  order     Int             @default(0)
  active    Boolean         @default(true)
  createdAt DateTime        @default(now()) @db.Timestamptz
  updatedAt DateTime        @updatedAt @db.Timestamptz
  deletedAt DateTime?       @db.Timestamptz

  tenant        Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  stages        PipelineStage[]
  opportunities Opportunity[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("pipelines")
}

model PipelineStage {
  id                 String    @id @default(uuid()) @db.Uuid
  tenantId           String    @db.Uuid
  pipelineId         String    @db.Uuid
  name               String    @db.VarChar(100)
  order              Int       @default(0)
  color              String    @default("#A8462F") @db.VarChar(30)
  defaultProbability Int       @default(20)
  rottingDays        Int       @default(14)
  requiredFields     String[]  @default([])
  stageType          StageType @default(OPEN)
  createdAt          DateTime  @default(now()) @db.Timestamptz
  updatedAt          DateTime  @updatedAt @db.Timestamptz
  deletedAt          DateTime? @db.Timestamptz

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  pipeline      Pipeline       @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  opportunities Opportunity[]
  stageHistories StageHistory[]

  @@unique([pipelineId, name])
  @@index([tenantId])
  @@index([pipelineId, order])
  @@map("pipeline_stages")
}

enum StageType {
  OPEN
  WON
  LOST
}

model Opportunity {
  id                 String           @id @default(uuid()) @db.Uuid
  tenantId           String           @db.Uuid
  title              String           @db.VarChar(255)
  contactId          String?          @db.Uuid
  companyId          String?          @db.Uuid
  pipelineId         String           @db.Uuid
  stageId            String           @db.Uuid
  value              Decimal          @default(0.00) @db.Decimal(16, 2)
  currency           String           @default("USD") @db.VarChar(10)
  probability        Int              @default(20)
  expectedCloseDate  DateTime?        @db.Date
  forecastCategory   ForecastCategory @default(PIPELINE)
  ownerId            String?          @db.Uuid
  teamId             String?          @db.Uuid
  competitors        String[]         @default([])
  wonReason          String?          @db.Text
  lostReason         String?          @db.Text
  nextStep           String?          @db.VarChar(255)
  stageEnteredAt     DateTime         @default(now()) @db.Timestamptz
  lastActivityAt     DateTime?        @db.Timestamptz
  customFields       Json             @default("{}")
  createdAt          DateTime         @default(now()) @db.Timestamptz
  updatedAt          DateTime         @updatedAt @db.Timestamptz
  deletedAt          DateTime?        @db.Timestamptz
  createdBy          String?          @db.Uuid
  updatedBy          String?          @db.Uuid

  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact          Contact?          @relation(fields: [contactId], references: [id])
  company          Company?          @relation(fields: [companyId], references: [id])
  pipeline         Pipeline          @relation(fields: [pipelineId], references: [id])
  stage            PipelineStage     @relation(fields: [stageId], references: [id])
  owner            User?             @relation(fields: [ownerId], references: [id])
  team             Team?             @relation(fields: [teamId], references: [id])

  lineItems        DealLineItem[]
  stageHistories   StageHistory[]
  quotes           Quote[]
  approvalRequests ApprovalRequest[]

  @@index([tenantId])
  @@index([tenantId, pipelineId, stageId])
  @@index([tenantId, ownerId])
  @@index([tenantId, expectedCloseDate])
  @@index([tenantId, forecastCategory])
  @@map("opportunities")
}

enum ForecastCategory {
  PIPELINE
  BEST_CASE
  COMMIT
  CLOSED
  OMITTED
}

model StageHistory {
  id              String        @id @default(uuid()) @db.Uuid
  tenantId        String        @db.Uuid
  dealId          String        @db.Uuid
  stageId         String        @db.Uuid
  fromStageId     String?       @db.Uuid
  enteredAt       DateTime      @default(now()) @db.Timestamptz
  leftAt          DateTime?     @db.Timestamptz
  durationSeconds Int           @default(0)
  changedBy       String?       @db.Uuid

  tenant Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  deal   Opportunity   @relation(fields: [dealId], references: [id], onDelete: Cascade)
  stage  PipelineStage @relation(fields: [stageId], references: [id])

  @@index([tenantId])
  @@index([dealId])
  @@map("stage_histories")
}

model DealLineItem {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @db.Uuid
  dealId          String   @db.Uuid
  productId       String?  @db.Uuid
  name            String   @db.VarChar(255)
  description     String?  @db.Text
  quantity        Decimal  @default(1.00) @db.Decimal(12, 2)
  unitPrice       Decimal  @default(0.00) @db.Decimal(14, 2)
  discountPercent Decimal  @default(0.00) @db.Decimal(5, 2)
  taxPercent      Decimal  @default(0.00) @db.Decimal(5, 2)
  totalPrice      Decimal  @default(0.00) @db.Decimal(16, 2)
  createdAt       DateTime @default(now()) @db.Timestamptz
  updatedAt       DateTime @updatedAt @db.Timestamptz

  tenant  Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  deal    Opportunity @relation(fields: [dealId], references: [id], onDelete: Cascade)
  product Product?    @relation(fields: [productId], references: [id])

  @@index([tenantId])
  @@index([dealId])
  @@map("deal_line_items")
}

// ─── Products, Catalog & Price Lists ───────────────────────

model Product {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String    @db.Uuid
  name         String    @db.VarChar(255)
  sku          String    @db.VarChar(100)
  description  String?   @db.Text
  category     String?   @db.VarChar(100)
  unitPrice    Decimal   @default(0.00) @db.Decimal(14, 2)
  currency     String    @default("USD") @db.VarChar(10)
  taxRate      Decimal   @default(0.00) @db.Decimal(5, 2)
  active       Boolean   @default(true)
  customFields Json      @default("{}")
  createdAt    DateTime  @default(now()) @db.Timestamptz
  updatedAt    DateTime  @updatedAt @db.Timestamptz
  deletedAt    DateTime? @db.Timestamptz

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  dealLineItems DealLineItem[]

  // ERP relations
  quotationLines QuotationLine[]
  orderLines     SalesOrderLine[]
  stockMoves     StockMove[]

  @@unique([tenantId, sku])
  @@index([tenantId])
  @@map("products")
}

model PriceList {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String    @db.Uuid
  name         String    @db.VarChar(100)
  currency     String    @default("USD") @db.VarChar(10)
  customerTier String?   @db.VarChar(50)
  active       Boolean   @default(true)
  items        Json      @default("[]") // [{ productId: string, price: number, minQuantity: number }]
  createdAt    DateTime  @default(now()) @db.Timestamptz
  updatedAt    DateTime  @updatedAt @db.Timestamptz
  deletedAt    DateTime? @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("price_lists")
}

// ─── Quotes & Sales Handoff ─────────────────────────────────

model Quote {
  id            String      @id @default(uuid()) @db.Uuid
  tenantId      String      @db.Uuid
  quoteNumber   String      @db.VarChar(100)
  dealId        String?     @db.Uuid
  companyId     String?     @db.Uuid
  contactId     String?     @db.Uuid
  status        QuoteStatus @default(DRAFT)
  validUntil    DateTime?   @db.Date
  subtotal      Decimal     @default(0.00) @db.Decimal(16, 2)
  taxTotal      Decimal     @default(0.00) @db.Decimal(16, 2)
  grandTotal    Decimal     @default(0.00) @db.Decimal(16, 2)
  currency      String      @default("USD") @db.VarChar(10)
  terms         String?     @db.Text
  notes         String?     @db.Text
  lineItems     Json        @default("[]")
  signedAt      DateTime?   @db.Timestamptz
  signatureData String?     @db.Text
  pdfUrl        String?     @db.Text
  createdAt     DateTime    @default(now()) @db.Timestamptz
  updatedAt     DateTime    @updatedAt @db.Timestamptz
  deletedAt     DateTime?   @db.Timestamptz
  createdBy     String?     @db.Uuid

  tenant  Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  deal    Opportunity? @relation(fields: [dealId], references: [id])
  company Company?     @relation(fields: [companyId], references: [id])
  contact Contact?     @relation(fields: [contactId], references: [id])

  @@unique([tenantId, quoteNumber])
  @@index([tenantId])
  @@index([dealId])
  @@map("quotes")
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

// ─── Activities, Tasks & Calendaring ────────────────────────

model Activity {
  id              String           @id @default(uuid()) @db.Uuid
  tenantId        String           @db.Uuid
  type            ActivityType     @default(TASK)
  subject         String           @db.VarChar(255)
  description     String?          @db.Text
  dueDateTime     DateTime?        @db.Timestamptz
  durationMinutes Int?             @default(30)
  status          ActivityStatus   @default(PENDING)
  priority        ActivityPriority @default(MEDIUM)
  assigneeId      String?          @db.Uuid
  relatedType     String           @db.VarChar(50) // 'lead', 'deal', 'contact', 'company'
  relatedId       String           @db.Uuid
  outcome         String?          @db.Text
  reminders       Json             @default("[]") // [{ minutesBefore: 15, method: 'in_app' }]
  recurrence      Json?
  completedAt     DateTime?        @db.Timestamptz
  createdAt       DateTime         @default(now()) @db.Timestamptz
  updatedAt       DateTime         @updatedAt @db.Timestamptz
  deletedAt       DateTime?        @db.Timestamptz
  createdBy       String?          @db.Uuid

  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assignee User?  @relation(fields: [assigneeId], references: [id])

  @@index([tenantId])
  @@index([tenantId, assigneeId, status])
  @@index([tenantId, relatedType, relatedId])
  @@index([tenantId, dueDateTime])
  @@map("activities")
}

enum ActivityType {
  CALL
  EMAIL
  MEETING
  TASK
  NOTE
  WHATSAPP
  SMS
  VISIT
}

enum ActivityStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum ActivityPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

// ─── Unified Communications Layer ───────────────────────────

model Communication {
  id           String                @id @default(uuid()) @db.Uuid
  tenantId     String                @db.Uuid
  channel      CommunicationChannel  @default(EMAIL)
  direction    CommunicationDirection @default(OUTBOUND)
  subject      String?               @db.VarChar(255)
  body         String                @db.Text
  sender       String                @db.VarChar(255)
  recipient    String                @db.VarChar(255)
  messageId    String?               @db.VarChar(255)
  threadId     String?               @db.VarChar(255)
  status       CommunicationStatus   @default(SENT)
  recordingUrl String?               @db.Text
  relatedType  String                @db.VarChar(50) // 'lead', 'deal', 'contact', 'company'
  relatedId    String                @db.Uuid
  createdAt    DateTime              @default(now()) @db.Timestamptz
  createdBy    String?               @db.Uuid

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, relatedType, relatedId])
  @@index([tenantId, threadId])
  @@map("communications")
}

enum CommunicationChannel {
  EMAIL
  WHATSAPP
  SMS
  CALL
}

enum CommunicationDirection {
  INBOUND
  OUTBOUND
}

enum CommunicationStatus {
  SENT
  DELIVERED
  READ
  FAILED
}

// ─── Attachments & Documents ────────────────────────────────

model Attachment {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @db.Uuid
  name        String    @db.VarChar(255)
  fileName    String    @db.VarChar(255)
  fileUrl     String    @db.Text
  mimeType    String    @db.VarChar(100)
  sizeBytes   BigInt
  relatedType String    @db.VarChar(50)
  relatedId   String    @db.Uuid
  folder      String?   @db.VarChar(100)
  version     Int       @default(1)
  tags        String[]  @default([])
  createdAt   DateTime  @default(now()) @db.Timestamptz
  createdBy   String?   @db.Uuid
  deletedAt   DateTime? @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, relatedType, relatedId])
  @@map("attachments")
}

// ─── Custom Fields & Saved Views ────────────────────────────

model CustomFieldDefinition {
  id             String          @id @default(uuid()) @db.Uuid
  tenantId       String          @db.Uuid
  entityType     CustomFieldEntity
  fieldName      String          @db.VarChar(100)
  fieldLabel     String          @db.VarChar(150)
  fieldType      CustomFieldType @default(TEXT)
  options        Json            @default("[]") // For select, multi-select
  isRequired     Boolean         @default(false)
  isUnique       Boolean         @default(false)
  defaultValue   Json?
  roleVisibility Json            @default("{}") // { roleId: { canView: true, canEdit: true } }
  displayOrder   Int             @default(0)
  section        String          @default("General") @db.VarChar(100)
  createdAt      DateTime        @default(now()) @db.Timestamptz
  updatedAt      DateTime        @updatedAt @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, entityType, fieldName])
  @@index([tenantId])
  @@map("custom_field_definitions")
}

enum CustomFieldEntity {
  LEAD
  CONTACT
  COMPANY
  DEAL
  ACTIVITY
}

enum CustomFieldType {
  TEXT
  LONG_TEXT
  NUMBER
  CURRENCY
  PERCENT
  DATE
  DATETIME
  SELECT
  MULTI_SELECT
  CHECKBOX
  URL
  EMAIL
  PHONE
  USER
  FORMULA
}

model SavedView {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @db.Uuid
  entityType String   @db.VarChar(50)
  name       String   @db.VarChar(100)
  isShared   Boolean  @default(false)
  isDefault  Boolean  @default(false)
  filters    Json     @default("[]") // Array of nested filter conditions
  columns    String[] @default([])
  sortBy     String?  @db.VarChar(50)
  sortOrder  String?  @default("desc") @db.VarChar(10)
  groupBy    String?  @db.VarChar(50)
  createdBy  String   @db.Uuid
  createdAt  DateTime @default(now()) @db.Timestamptz
  updatedAt  DateTime @updatedAt @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, entityType])
  @@map("saved_views")
}

// ─── Automations, Sequences & Forms ─────────────────────────

model AutomationRule {
  id             String    @id @default(uuid()) @db.Uuid
  tenantId       String    @db.Uuid
  name           String    @db.VarChar(255)
  description    String?   @db.Text
  triggerEvent   String    @db.VarChar(100) // e.g. 'lead.created', 'deal.stage_changed', 'date.reached'
  entityType     String    @db.VarChar(50)
  conditions     Json      @default("[]")   // Tree of { field, operator, value }
  actions        Json      @default("[]")   // Array of { type, params }
  active         Boolean   @default(true)
  executionCount Int       @default(0)
  lastExecutedAt DateTime? @db.Timestamptz
  createdAt      DateTime  @default(now()) @db.Timestamptz
  updatedAt      DateTime  @updatedAt @db.Timestamptz
  createdBy      String?   @db.Uuid

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, triggerEvent, active])
  @@map("automation_rules")
}

model Sequence {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  name        String   @db.VarChar(255)
  description String?  @db.Text
  entityType  String   @default("lead") @db.VarChar(50)
  active      Boolean  @default(true)
  stopOnReply Boolean  @default(true)
  steps       Json     @default("[]") // Array of { stepNumber, type, waitDays, templateId }
  createdAt   DateTime @default(now()) @db.Timestamptz
  updatedAt   DateTime @updatedAt @db.Timestamptz
  createdBy   String?  @db.Uuid

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("sequences")
}

model WebForm {
  id               String   @id @default(uuid()) @db.Uuid
  tenantId         String   @db.Uuid
  name             String   @db.VarChar(255)
  targetEntity     String   @default("lead") @db.VarChar(50)
  fieldMappings    Json     @default("[]")
  styleConfig      Json     @default("{}")
  honeypotEnabled  Boolean  @default(true)
  captchaEnabled   Boolean  @default(false)
  successMessage   String   @default("Thank you for reaching out!") @db.VarChar(255)
  redirectUrl      String?  @db.Text
  embedCode        String?  @db.Text
  publicToken      String   @unique @db.VarChar(100)
  active           Boolean  @default(true)
  submissionsCount Int      @default(0)
  createdAt        DateTime @default(now()) @db.Timestamptz
  updatedAt        DateTime @updatedAt @db.Timestamptz
  createdBy        String?  @db.Uuid

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([publicToken])
  @@map("web_forms")
}

