# ─── Database ───────────────────────────────────────────────
# Local MongoDB (Docker / standalone with replica set rs0):
DATABASE_URL="mongodb://localhost:27017/bahi_dev?replicaSet=rs0"
# MongoDB Atlas (Cloud Free Tier):
# DATABASE_URL="mongodb+srv://<username>:<password>@<cluster>.mongodb.net/bahi_dev?retryWrites=true&w=majority"

# ─── Redis ──────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ─── Auth / JWT ─────────────────────────────────────────────
JWT_SECRET="change-me-to-a-random-64-char-string"
JWT_REFRESH_SECRET="change-me-to-another-random-64-char-string"
JWT_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"

# ─── API Server ─────────────────────────────────────────────
PORT=4000
NODE_ENV="development"

# ─── Frontend ───────────────────────────────────────────────
NEXT_PUBLIC_API_URL="http://localhost:4000/api/v1"

# ─── Object Storage (S3-compatible) ────────────────────────
S3_BUCKET=""
S3_REGION=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_ENDPOINT=""
