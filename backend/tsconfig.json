{
  "extends": "@bahi/tsconfig/node.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "baseUrl": "./",
    "paths": {
      "@/*": ["src/*"],
      "@bahi/core": ["src/modules/core/index.ts"],
      "@bahi/core/*": ["src/modules/core/*"],
      "@bahi/common": ["src/common/index.ts"],
      "@bahi/common/*": ["src/common/*"]
    }
  },
  "include": ["src"]
}
