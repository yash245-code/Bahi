  COMPLETED
  FAILED
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @db.Uuid
  userId     String?  @db.Uuid
  action     String   @db.VarChar(50) // 'CREATE', 'UPDATE', 'DELETE', 'STAGE_CHANGE', 'CONVERT'
