# ─── Database (PostgreSQL with RLS & pg_trgm) ────────────────
DATABASE_URL="postgresql://bahi:bahi_dev_secret@localhost:5432/bahi_dev?schema=public"

# ─── Redis (Cache, Rate Limiting, BullMQ) ─────────────────────
REDIS_URL="redis://localhost:6379"

# ─── Auth / JWT & Argon2 ─────────────────────────────────────
JWT_SECRET="bahi-jwt-development-secret-key-at-least-64-characters-long-12345678"
JWT_REFRESH_SECRET="bahi-jwt-refresh-development-secret-key-at-least-64-characters-long-12345678"
JWT_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"

# ─── API Server ──────────────────────────────────────────────
PORT=4000
NODE_ENV="development"
FRONTEND_URL="http://localhost:3000"

# ─── Frontend ────────────────────────────────────────────────
NEXT_PUBLIC_API_URL="http://localhost:4000/api/v1"

# ─── Object Storage (S3 / MinIO) ─────────────────────────────
S3_BUCKET="bahi-attachments"
S3_REGION="us-east-1"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin123"
S3_ENDPOINT="http://localhost:9000"

# ─── Mailer / Mailhog (Local Dev) ────────────────────────────
SMTP_HOST="localhost"
SMTP_PORT=1025
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@bahi.app"
