enum NotificationType {
  ASSIGNMENT
  MENTION
  TASK_DUE
  STAGE_CHANGE
  DEAL_WON
  SYSTEM
}

model ApprovalRequest {
  id              String         @id @default(uuid()) @db.Uuid
  tenantId        String         @db.Uuid
  dealId          String         @db.Uuid
  requestedById   String         @db.Uuid
  approverId      String         @db.Uuid
  type            ApprovalType   @default(DISCOUNT_OVER_THRESHOLD)
  discountPercent Decimal?       @db.Decimal(5, 2)
  dealValue       Decimal?       @db.Decimal(16, 2)
  status          ApprovalStatus @default(PENDING)
  comments        String?        @db.Text
  approvedAt      DateTime?      @db.Timestamptz
  createdAt       DateTime       @default(now()) @db.Timestamptz
  updatedAt       DateTime       @updatedAt @db.Timestamptz

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  deal        Opportunity @relation(fields: [dealId], references: [id], onDelete: Cascade)
  requester   User        @relation("ApprovalRequester", fields: [requestedById], references: [id])
  approver    User        @relation("ApprovalApprover", fields: [approverId], references: [id])

  @@index([tenantId])
  @@index([dealId])
  @@map("approval_requests")
}

enum ApprovalType {
  DISCOUNT_OVER_THRESHOLD
  DEAL_VALUE_EXCEPTION
  STAGE_SKIP
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

// ─── Modular ERP Suite Stubs ────────────────────────────────
// Preserved for cross-module integrity with Sales, Inventory,
// Accounting, HR, and Projects.

model Quotation {
  id          String         @id @default(uuid()) @db.Uuid
  tenantId    String         @db.Uuid
  contactId   String         @db.Uuid
  subtotal    Decimal        @db.Decimal(14, 2)
  tax         Decimal        @db.Decimal(14, 2)
  total       Decimal        @db.Decimal(14, 2)
  status      String         @default("DRAFT")
  createdAt   DateTime       @default(now()) @db.Timestamptz
  updatedAt   DateTime       @updatedAt @db.Timestamptz

  tenant      Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact     Contact        @relation(fields: [contactId], references: [id])
  lines       QuotationLine[]
  salesOrders SalesOrder[]

  @@index([tenantId])
  @@map("quotations")
}

model QuotationLine {
  id          String    @id @default(uuid()) @db.Uuid
  quotationId String    @db.Uuid
  productId   String    @db.Uuid
  quantity    Decimal   @db.Decimal(12, 2)
  unitPrice   Decimal   @db.Decimal(14, 2)
  total       Decimal   @db.Decimal(14, 2)

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id])

  @@map("quotation_lines")
}

model SalesOrder {
  id          String           @id @default(uuid()) @db.Uuid
  tenantId    String           @db.Uuid
  contactId   String           @db.Uuid
  quotationId String?          @db.Uuid
  subtotal    Decimal          @db.Decimal(14, 2)
  tax         Decimal          @db.Decimal(14, 2)
  total       Decimal          @db.Decimal(14, 2)
  status      String           @default("DRAFT")
  createdAt   DateTime         @default(now()) @db.Timestamptz
  updatedAt   DateTime         @updatedAt @db.Timestamptz

  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact   Contact          @relation(fields: [contactId], references: [id])
  quotation Quotation?       @relation(fields: [quotationId], references: [id])
  lines     SalesOrderLine[]

  @@index([tenantId])
  @@map("sales_orders")
}

model SalesOrderLine {
  id           String     @id @default(uuid()) @db.Uuid
  salesOrderId String     @db.Uuid
  productId    String     @db.Uuid
  quantity     Decimal    @db.Decimal(12, 2)
  unitPrice    Decimal    @db.Decimal(14, 2)
  total        Decimal    @db.Decimal(14, 2)

  salesOrder SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  product    Product    @relation(fields: [productId], references: [id])

  @@map("sales_order_lines")
}

model Warehouse {
  id        String      @id @default(uuid()) @db.Uuid
  tenantId  String      @db.Uuid
  name      String      @db.VarChar(100)
  location  String?     @db.VarChar(255)
  createdAt DateTime    @default(now()) @db.Timestamptz

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  stockMoves StockMove[]

  @@index([tenantId])
  @@map("warehouses")
}

model StockMove {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  productId   String   @db.Uuid
  warehouseId String   @db.Uuid
  quantity    Decimal  @db.Decimal(12, 2)
  type        String   @db.VarChar(50) // 'RECEIPT', 'DELIVERY', 'INTERNAL'
  createdAt   DateTime @default(now()) @db.Timestamptz

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id])
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])

  @@index([tenantId])
  @@map("stock_moves")
}

model Invoice {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @db.Uuid
  contactId String    @db.Uuid
  amount    Decimal   @db.Decimal(14, 2)
  status    String    @default("DRAFT")
  createdAt DateTime  @default(now()) @db.Timestamptz
