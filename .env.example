# ─── Database (PostgreSQL with RLS & pg_trgm) ────────────────
DATABASE_URL="postgresql://bahi:bahi_dev_secret@localhost:5432/bahi_dev?schema=public"

# ─── Auth / JWT & Argon2 ─────────────────────────────────────
JWT_SECRET="bahi-jwt-development-secret-key-at-least-64-characters-long-12345678"
JWT_REFRESH_SECRET="bahi-jwt-refresh-development-secret-key-at-least-64-characters-long-12345678"
JWT_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"

# ─── API Server ──────────────────────────────────────────────
PORT=4000
NODE_ENV="development"
FRONTEND_URL="http://localhost:3000"

# ─── Frontend ────────────────────────────────────────────────
NEXT_PUBLIC_API_URL="http://localhost:4000/api/v1"
